# Supabase — copie este arquivo para .env.local e preencha os valores
# Obtenha em: https://supabase.com/dashboard/project/SEU_PROJETO/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Chrome WebMCP Origin Trial — token emitido para https://www.inema.club
WEBMCP_ORIGIN_TRIAL_TOKEN=token_emitido_pelo_chrome_origin_trials
WEBMCP_ORIGIN_TRIAL_EXPIRES=AAAA-MM-DD
# Use third-party quando o token tiver sido emitido com Third-party matching.
WEBMCP_ORIGIN_TRIAL_MODE=first-party
